  "narrative": {
    "northStar": "The Illustrated Personality Wheel",
    "overview": "The supplied reference establishes the visual identity: a white ground, bold dark-gray headings, black chart outlines, and seven colorful illustrations. The interface uses familiar controls and ample space so the test and its result diagram remain the focus. This records the implemented reference treatment, rather than a new visual direction.\n\nThe illustration set is extracted from the user-provided reference. Keep those assets recognizable and proportionate. Roboto carries the interface and export headings; the chart itself uses Arial for its SVG labels and percentages.",
    "keyCharacteristics": [
      "White surfaces and dark-gray, bold sans-serif hierarchy.",
      "Green actions, blue links, and independently colored result sectors.",
      "Familiar bordered answer rows and restrained rounding.",
      "Illustrations and strong black geometry give results their character."
    ],
    "rules": [
      {
        "name": "The Action and Data Rule",
        "body": "Green controls and blue links retain their interaction roles; the seven trait colors communicate results.",
        "section": "colors"
      },
      {
        "name": "The Reference Hierarchy Rule",
        "body": "Keep the large dark-gray test title, the Results label, and the strongest-result sentence distinct from the chart's black labels.",
        "section": "typography"
      },
      {
        "name": "The Flat Controls Rule",
        "body": "Questionnaire rows and ordinary action buttons use borders or fill changes, without borrowing the result share control's shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the supplied illustrations, their proportions, and their order around the result diagram.",
      "**Do** use the primary green for white text controls and reserve blue for links and text actions.",
      "**Do** keep readable question controls on phones and scale the chart as a unit.",
      "**Do** retain keyboard focus visibility and reduced-motion behavior."
    ],
    "donts": [
      "**Don't** restore the superseded lavender visual direction.",
      "**Don't** replace the reference illustrations with unrelated glyphs or generic icon sets.",
      "**Don't** introduce shadows on the ordinary questionnaire controls.",
      "**Don't** make seven independent percentages appear to sum to a single total."
    ]
  }
}
